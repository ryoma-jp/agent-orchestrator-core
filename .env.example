POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+asyncpg://orchestrator:replace-with-a-long-random-database-password@db:5432/orchestrator
MANAGER_MODEL=replace-with-available-manager-model
WORKER_MODEL=replace-with-available-worker-model
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_COOKIE_SECURE=false
MAX_CONCURRENT_AGENTS=4
MAX_AGENT_ATTEMPTS=3
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=local-vault-root-token
VAULT_CREDENTIAL_GID=1000
VAULT_KV_MOUNT=secret
VAULT_OPENAI_KEY_PATH=agent-orchestrator/openai
VAULT_API_ROLE_ID_SOURCE=./.local-vault/api-role-id
VAULT_API_SECRET_ID_SOURCE=./.local-vault/api-secret-id
VAULT_WORKER_ROLE_ID_SOURCE=./.local-vault/worker-role-id
VAULT_WORKER_SECRET_ID_SOURCE=./.local-vault/worker-secret-id
OPENAI_BASE_URL=https://api.openai.com/v1
