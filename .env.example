POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+asyncpg://orchestrator:replace-with-a-long-random-database-password@db:5432/orchestrator
MANAGER_MODEL_PROVIDER=openai
MANAGER_MODEL=gpt-6.1-sol
WORKER_MODEL_PROVIDER=openai
WORKER_MODEL=gpt-6-luna
WORKER_IMAGE_PROVIDER=openai
WORKER_IMAGE_MODEL=gpt-image-2.5-sunburst
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_COOKIE_SECURE=false
MAX_CONCURRENT_AGENTS=4
MAX_AGENT_ATTEMPTS=3
MAX_AGENT_TURNS=24
MAX_TOOL_CALLS_PER_SUBTASK=20
WORKSPACE_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
WORKSPACE_ARTIFACT_TIMEOUT_SECONDS=60
WORKSPACE_ARTIFACT_MAX_ATTEMPTS=3
TAVILY_TIMEOUT_SECONDS=20
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://comfyui:8188
COMFYUI_IMAGE_TAG=0.6.3
COMFYUI_MODELS_SOURCE=./.comfyui/models
COMFYUI_USER_ID=1000
COMFYUI_GROUP_ID=1000
COMFYUI_TIMEOUT_SECONDS=300
COMFYUI_MAX_IMAGE_BYTES=20971520
PRIVATE_SKILLS_SOURCE=./.ai_agent_base/private_skills
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=local-vault-root-token
VAULT_CREDENTIAL_GID=1000
VAULT_KV_MOUNT=secret
VAULT_OPENAI_KEY_PATH=agent-orchestrator/openai
VAULT_TAVILY_KEY_PATH=agent-orchestrator/tavily
VAULT_API_ROLE_ID_SOURCE=./.local-vault/api-role-id
VAULT_API_SECRET_ID_SOURCE=./.local-vault/api-secret-id
VAULT_WORKER_ROLE_ID_SOURCE=./.local-vault/worker-role-id
VAULT_WORKER_SECRET_ID_SOURCE=./.local-vault/worker-secret-id
OPENAI_BASE_URL=https://api.openai.com/v1
VAULT_MODEL_CATALOG_ROLE_ID_SOURCE=./.local-vault/model-catalog-role-id
VAULT_MODEL_CATALOG_SECRET_ID_SOURCE=./.local-vault/model-catalog-secret-id
